# Environment Configuration

# StoryGrab API
STORYGRAB_API_TOKEN=your_token_here

# DomainBox API
# DOMAINBOX_API_KEY=your_dnbx_key_here_while_no_auth_exists

# Cloudflare Turnstile API (defaults to Cloudflare always-pass testing keys if omitted)
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# GitHub API
# GITHUB_TOKEN=your_github_token_here

# HackClub CDN API (https://cdn.hackclub.com/docs/api)
# HACKCLUB_CDN_API_KEY=sk_cdn_your_key_here


# HackClub AI API (https://ai.hackclub.com)
# HACKCLUB_AI_API_KEY=sk-ai-v1-your_key_here

# Database Configuration (MySQL by default if set; falls back to storage/db.sqlite if omitted/failed)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=fabian_ternis_dev
# DB_USERNAME=root
# DB_PASSWORD=secret
# DB_SQLITE_PATH=storage/db.sqlite