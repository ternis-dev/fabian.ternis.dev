# Environment Configuration

# StoryGrab API
STORYGRAB_API_TOKEN=your_token_here

# DomainBox API
# DOMAINBOX_API_KEY=your_dnbx_key_here_while_no_auth_exists

# Cloudflare Turnstile API (defaults to Cloudflare always-pass testing keys if omitted)
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# GitHub API
# GITHUB_TOKEN=your_github_token_here
